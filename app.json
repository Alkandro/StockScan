
{
  "expo": {
    "name": "StockScan",
    "slug": "stockscan",
    "version": "1.2.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "stockscan",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "backgroundColor": "#020817",
      "barStyle": "light-content"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "StockScan necesita la cámara para leer códigos QR.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020817",
          "image": "./assets/splash.png",
          "imageWidth": 360,
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.alkandro.stockscan"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "409819c7-6051-4d14-855d-c4de552ec89a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/409819c7-6051-4d14-855d-c4de552ec89a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "com.alkandro.stockscan",
      "permissions": [
        "android.permission.CAMERA"
      ]
    }
  }
}
